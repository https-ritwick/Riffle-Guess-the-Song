{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "encore-music-quiz",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // The React build. Unknown paths fall back to index.html (client-side routing),
    // but /api/* always reaches the Worker first.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [
    // SQLite-backed Durable Objects are available on the Workers Free plan.
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "d1_databases": [
    // Accounts, groups and group game history.
    { "binding": "DB", "database_name": "encore-db", "database_id": "e92ec55c-0b15-4709-b0a2-3c55d98bf674", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
