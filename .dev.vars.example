# Copy to .dev.vars for local development.
# Enables the "developer sign-in" button on http://localhost only (for testing groups without Google).
DEV_LOGIN=true
# Admin console (/admin): Google accounts allowed in, comma-separated. Defaults to the site owner's email.
# Locally, a developer sign-in with one of these emails also gets in.
ADMIN_EMAILS=
# Optional: real Google sign-in locally. Add http://localhost:5290/api/auth/google/callback
# as an authorised redirect URI in your Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: "Connect Spotify" for Blend games. Create an app at https://developer.spotify.com/dashboard
# and add http://127.0.0.1:5290/api/spotify/callback as a redirect URI (Spotify does not accept "localhost"),
# then open the app at http://127.0.0.1:5290 instead of localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: AI-written questions for the Dialogue / Star / Emoji challenges and fresh award
# names every game, from Google Gemini. Get a key at https://aistudio.google.com/apikey
# (the games work without it). GEMINI_MODEL optionally picks a model to try first.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: TURN relay for the voice channel, for players on strict NATs / firewalls
# (STUN alone works for most). Create a TURN key under Cloudflare dashboard → Realtime → TURN.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
