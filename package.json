{
  "name": "riffle-music-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Riffle — a free, real-time guess-the-song party game with playlists, live leaderboards and Google-sign-in groups. React + Vite, Cloudflare Workers, Durable Objects and D1.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "deploy": "vite build && wrangler deploy",
    "covers": "node scripts/build-covers.mjs",
    "og": "node scripts/build-og.mjs",
    "db:migrate:local": "wrangler d1 migrations apply riffle-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply riffle-db --remote"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
